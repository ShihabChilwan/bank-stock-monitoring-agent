# Comma-separated list of bank stock tickers to track.
# Use Yahoo Finance ticker symbols (NSE tickers need the ".NS" suffix).
BANK_TICKERS=HDFCBANK.NS,ICICIBANK.NS,SBIN.NS

# A day's price move beyond this percentage gets flagged as "notable" in the email.
MOVE_THRESHOLD_PCT=3.0

# How many days of history to pull for computing trends.
HISTORY_WINDOW_DAYS=30

# Window size for the moving average shown in the email.
MOVING_AVERAGE_DAYS=7

# Local LLM served by Ollama.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Gmail SMTP settings. EMAIL_APP_PASSWORD must be a Gmail "App Password",
# not your normal account password (requires 2FA to be enabled on the account).
EMAIL_SENDER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_RECIPIENT=your_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Where the SQLite database file lives.
DB_PATH=data/agent_memory.db

# Default time the cron job runs, used the first time the schedule is set up.
# The Streamlit app can change this later without editing this file.
DEFAULT_CRON_HOUR=8
DEFAULT_CRON_MINUTE=0
